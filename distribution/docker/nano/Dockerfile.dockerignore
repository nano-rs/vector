# Build context for distribution/docker/nano/Dockerfile (BuildKit reads <Dockerfile>.dockerignore
# instead of the root .dockerignore): upstream's list plus config/examples for /etc/vector/examples
# and the FEATURES file the build reads.
*
!benches
!lib
!proto
!src
!tests
!build.rs
!Cargo.lock
!Cargo.toml
!rust-toolchain.toml
!scripts
!vdev

# Exclude target directories to avoid copying build artifacts
target

!config/examples
!distribution/docker/nano/FEATURES
